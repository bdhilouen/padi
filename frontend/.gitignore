# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# ─── Dependencies ────────────────────────────────────────────────────────────
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ─── Testing ─────────────────────────────────────────────────────────────────
/coverage

# ─── Next.js build output ────────────────────────────────────────────────────
/.next/
/out/
/build

# ─── Environment variables ───────────────────────────────────────────────────
# Semua .env file dikecualikan kecuali .env.example (boleh di-commit sebagai referensi)
.env
.env.*
!.env.example

# ─── Vercel ──────────────────────────────────────────────────────────────────
.vercel

# ─── TypeScript ──────────────────────────────────────────────────────────────
*.tsbuildinfo
next-env.d.ts

# ─── Debug logs ──────────────────────────────────────────────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# ─── OS artifacts ────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ─── Editor artifacts ────────────────────────────────────────────────────────
.idea/
*.swp
*.swo
.vscode/settings.json

# ─── Misc ────────────────────────────────────────────────────────────────────
*.pem
