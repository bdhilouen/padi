# ─── Required for Vercel Deployment ──────────────────────────────────────────
# URL prefix yang digunakan oleh apiClient di frontend.
# Karena Next.js rewrites sudah dikonfigurasi di next.config.ts,
# cukup set ke /api/v1 (relative) — tidak perlu URL backend lengkap.
NEXT_PUBLIC_API_URL=/api/v1

# ─── Backend URL (server-side only, tidak perlu NEXT_PUBLIC_) ─────────────────
# URL backend Railway yang digunakan oleh Next.js rewrites di next.config.ts.
# Default: https://padi-api-cihuy.up.railway.app (jika tidak diisi)
BACKEND_URL=https://padi-api-cihuy.up.railway.app
