      "name": "1. Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nik\": \"3201012501990001\",\n  \"email\": \"keivra@example.com\",\n  \"password\": \"Password123!\",\n  \"full_name\": \"Keivra Ananta\",\n  \"phone_number\": \"081234567890\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "description": "Response 201: { id, email, full_name, phone_number, created_at } — nik/password_hash tidak pernah dikembalikan ke client."
          },
          "response": []
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200 || pm.response.code === 201) {\r",
                  "    const body = pm.response.json();\r",
                  "\r",
                  "    if (body.accessToken) {\r",
                  "        pm.collectionVariables.set(\"accessToken\", body.accessToken);\r",
                  "    }\r",
                  "    if (body.refreshToken) {\r",
                  "        pm.collectionVariables.set(\"refreshToken\", body.refreshToken);\r",
                  "        console.log(\"refreshToken tersimpan (backend nyimpen hash-nya di tabel refresh_tokens)\");\r",
                  "    }\r",
                  "\r",
                  "    pm.test(\"Login berhasil\", function () {\r",
                  "        pm.expect(pm.response.code).to.be.oneOf([200, 201]);\r",
                  "    });\r",
                  "    pm.test(\"Response berisi accessToken dan refreshToken\", function () {\r",
                  "        pm.expect(body).to.have.property(\"accessToken\");\r",
                  "        pm.expect(body).to.have.property(\"refreshToken\");\r",
                  "    });\r",
                  "} else {\r",
                  "    pm.test(\"Login gagal\", function () {\r",
                  "        pm.expect.fail(`Status ${pm.response.code}: ${pm.response.body}`);\r",
                  "    });\r",
                  "}"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nik\": \"3201012501990001\",\n  \"password\": \"Password123!\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "SSO pakai NIK atau Email + Password (FR-012). Response 200: { accessToken, refreshToken, user: { id, email, full_name } }"
          },
          "response": []
        },
        {
          "name": "Refresh Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {\r",
                  "    const body = pm.response.json();\r",
                  "\r",
                  "    if (body.accessToken) {\r",
                  "        pm.collectionVariables.set(\"accessToken\", body.accessToken);\r",
                  "        console.log(\"accessToken diperbarui\");\r",
                  "    }\r",
                  "\r",
                  "    // Kalau backend nerapin token rotation, refreshToken lama otomatis\r",
                  "    // ke-revoke dan yang baru wajib disimpan, atau request selanjutnya bakal gagal\r",
                  "    if (body.refreshToken) {\r",
                  "        pm.collectionVariables.set(\"refreshToken\", body.refreshToken);\r",
                  "        console.log(\"refreshToken juga diperbarui (rotation aktif)\");\r",
                  "    }\r",
                  "\r",
                  "    pm.test(\"Refresh berhasil\", function () {\r",
                  "        pm.expect(pm.response.code).to.equal(200);\r",
                  "    });\r",
                  "} else if (pm.response.code === 401) {\r",
                  "    pm.test(\"Refresh token expired/revoked, harus login ulang\", function () {\r",
                  "        pm.expect(pm.response.code).to.equal(401);\r",
                  "    });\r",
                  "}"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/auth/refresh",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "refresh"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
